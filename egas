#!/usr/bin/env bash
set -euo pipefail
EGAS_PROJECT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "${EGAS_PROJECT}/scripts/desktop_env.sh"
if [[ "${1:-}" == build ]]; then
    shift
    exec bash "${EGAS_PROJECT}/scripts/desktop_build.sh" "$@"
elif [[ "${1:-}" == summary ]]; then
    shift
    exec "${EGAS_PYTHON}" "${EGAS_PROJECT}/scripts/desktop_summarize.py" "$@"
elif [[ "${1:-}" == viewer ]]; then
    shift
    exec "${EGAS_PYTHON}" "${EGAS_PROJECT}/scripts/demo_viewer.py" "$@"
elif [[ "${1:-}" == demo-export ]]; then
    shift
    exec "${EGAS_PYTHON}" "${EGAS_PROJECT}/scripts/demo_export.py" "$@"
fi
exec "${EGAS_PYTHON}" "${EGAS_PROJECT}/scripts/desktop_run.py" "$@"
