set(GPS_SLAM_TSDF_HASH_PROFILE "legacy_large" CACHE STRING "InfiniTAM compile-time capacity profile")
set(GPS_SLAM_HASH_PROFILES legacy_large medium_128k compact_64k
    legacy_pool_512k legacy_pool_1m legacy_256k_hash4m legacy_pool_2m legacy_256k_hash8m)
set_property(CACHE GPS_SLAM_TSDF_HASH_PROFILE PROPERTY STRINGS ${GPS_SLAM_HASH_PROFILES})
if(NOT GPS_SLAM_TSDF_HASH_PROFILE IN_LIST GPS_SLAM_HASH_PROFILES)
    message(FATAL_ERROR "Unsupported GPS_SLAM_TSDF_HASH_PROFILE=${GPS_SLAM_TSDF_HASH_PROFILE}")
endif()
if(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "compact_64k")
    add_compile_definitions(GPS_SLAM_COMPACT_HASH)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "medium_128k")
    add_compile_definitions(GPS_SLAM_MEDIUM_HASH)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "legacy_pool_512k")
    add_compile_definitions(GPS_SLAM_CAPACITY_CONTROL=1)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "legacy_pool_1m")
    add_compile_definitions(GPS_SLAM_CAPACITY_CONTROL=2)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "legacy_256k_hash4m")
    add_compile_definitions(GPS_SLAM_CAPACITY_CONTROL=3)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "legacy_pool_2m")
    add_compile_definitions(GPS_SLAM_CAPACITY_CONTROL=4)
elseif(GPS_SLAM_TSDF_HASH_PROFILE STREQUAL "legacy_256k_hash8m")
    add_compile_definitions(GPS_SLAM_CAPACITY_CONTROL=5)
endif()
